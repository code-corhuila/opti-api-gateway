# Routes of the workflow domain. Rendered by docker-entrypoint.d/15-render-routes.sh, substituting
# ${WORKFLOW_URL}.

location /api/v1/sagas {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $workflow ${WORKFLOW_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $workflow;
}
