# Routes of the customers domain. Rendered by docker-entrypoint.d/15-render-routes.sh, substituting
# ${CUSTOMERS_API_URL}.

location /api/v1/patients {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $customers_api ${CUSTOMERS_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $customers_api;
}
