# Routes of the sales domain. Rendered by docker-entrypoint.d/15-render-routes.sh, substituting
# ${SALES_API_URL}.

location /api/v1/work-orders {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $sales_api ${SALES_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $sales_api;
}

location /api/v1/invoices {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $sales_api ${SALES_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $sales_api;
}

location /api/v1/reports {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $sales_api ${SALES_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $sales_api;
}

# A 2 MiB private receipt needs up to 2.67 MiB in base64 plus JSON metadata.
# Keep the general API limit at 1 MiB; only payment creation accepts this body.
location ~ ^/api/v1/invoices/[0-9a-fA-F-]+/payments$ {
    client_max_body_size 3m;
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $sales_api ${SALES_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $sales_api;
}
