# Routes of the products domain. Rendered by docker-entrypoint.d/15-render-routes.sh, substituting
# ${PRODUCTS_API_URL}.

location /api/v1/frames {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    set $products_api ${PRODUCTS_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $products_api;
}

