# Frame photo upload (HU-16): a regex location takes priority over the plain /api/v1/frames
# prefix above, so only this path gets the larger body limit (2 MB file + multipart overhead);
# everything else keeps the global 1 MB ceiling.
location ~ ^/api/v1/frames/[^/]+/image$ {
    if ($request_method = OPTIONS) { include /etc/nginx/snippets/preflight.conf; }
    if ($has_credential = 0) { return 401; }
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 3m;
    set $products_api ${PRODUCTS_API_URL};
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $products_api;
}
